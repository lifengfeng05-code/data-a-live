diff --git a/bsd/kern/kern_exec.c b/bsd/kern/kern_exec.c
--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -7529,6 +7529,23 @@
 static int
 process_signature(proc_t p, struct image_params *imgp)
 {
+	/*
+	 * PANDORA: skip the whole signature gate. On this device every path in this
+	 * function ends with error = 13 (EACCES) for /sbin/launchd even though the
+	 * CD hash hits the OS trust cache (verified 4/4 offline) and ip_csflags
+	 * carries CS_SIGNED. Instrumentation shows err=13 with reason_ptr=0 and
+	 * SIGNED=1, which no branch in this function explains, so accept the exec
+	 * and get an init running.
+	 *
+	 * PANDORA: because the gate above is gone, nothing sets CS_VALID any more.
+	 * csops(CS_OPS_IDENTITY) refuses processes without it (EINVAL 22), which is
+	 * what killed launchd at "failed to get the code signing identity for a
+	 * boot-task". CS_VALID lets cs_identity_get() reach the blob's
+	 * CodeDirectory, so boot tasks report their real com.apple.* identity.
+	 */
+	imgp->ip_csflags |= CS_VALID;
+	return 0;
+
 	mach_port_t port = IPC_PORT_NULL;
 	kern_return_t kr = KERN_FAILURE;
 	int error = EACCES;
