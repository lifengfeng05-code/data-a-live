+/*
+ * PANDORA: stubs for the TrustCache interface. kern_trustcache.c checks
+ * amfi->TrustCache.version in five places and panics below 1/2/3, so the
+ * built-in AMFI reports version 2. trust_cache_rt stays NULL (patch 0336)
+ * so nothing is ever loaded, but callers still reach these pointers:
+ * return success and load nothing, matching the 0035 policy where every
+ * binary on the root filesystem is a platform binary anyway.
+ */
+static TCReturn_t
+sweet_amfi_tc_ok(void)
+{
+	TCReturn_t r = { .rawValue = 0 };
+	return r;
+}
+
+static TCReturn_t
+sweet_amfi_tc_load_module(__unused TrustCacheRuntime_t *runtime, __unused const TCType_t type,
+    __unused TrustCache_t *trustCache, __unused const uintptr_t dataAddr,
+    __unused const size_t dataSize)
+{
+	return sweet_amfi_tc_ok();
+}
+
+static TCReturn_t
+sweet_amfi_tc_load(__unused TrustCacheRuntime_t *runtime, __unused TCType_t type,
+    __unused TrustCache_t *trustCache, __unused const uintptr_t payloadAddr,
+    __unused const size_t payloadSize, __unused const uintptr_t manifestAddr,
+    __unused const size_t manifestSize)
+{
+	return sweet_amfi_tc_ok();
+}
+
+static TCReturn_t
+sweet_amfi_tc_query(__unused const TrustCacheRuntime_t *runtime, __unused TCQueryType_t queryType,
+    __unused const uint8_t CDHash[kTCEntryHashSize],
+    __unused TrustCacheQueryToken_t *queryToken)
+{
+	return sweet_amfi_tc_ok();
+}
+
+static TCReturn_t
+sweet_amfi_tc_get_capabilities(__unused const TrustCache_t *trustCache,
+    __unused TCCapabilities_t *capabilities)
+{
+	return sweet_amfi_tc_ok();
+}
+
 static void
 sweet_amfi_entitlements_invalidate(__unused void *os_entitlements)
 {
